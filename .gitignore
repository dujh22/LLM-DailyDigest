tools/config2.py
*.pyc
__pycache__/
.env
*.cfg
public/
.DS_Store

# 提交工具后端的 API Key（绝不入库）
api_key.txt
backend/venv/
venv/

# 批处理会话（运行时产物）
.batch_sessions/

# 当日推荐：公众号凭据（绝不入库）与按日采集缓存
wechat_credentials.json
.recommend_cache/
# oh-my-claudecode 运行时状态（任意层级，如 .omc/ 与 backend/.omc/）；
# 仅 .omc/skills/ 下的项目级技能允许入库
**/.omc/*
!**/.omc/skills/

# 趋势字段回填脚本的 OpenAlex 未命中/LLM 空结果缓存（运行时产物）
backend/.trends_backfill_cache.json

# 研究页跨进程写锁（运行时产物）
.research_write.lock

# 读后感数据集导出（派生产物，由 backend/build_reader_dataset.py 随时重建）
data/reader_dataset/
# 反馈提醒确认时间（每次确认都会变，不值得进 git）
data/feedback/state.json
data/feedback/.lock
data/feedback/*.tmp

# 论文复现：即用即下的数据 / 模型缓存（见 content/papers/README.md）
content/papers/**/cache/*
!content/papers/**/cache/.gitkeep
